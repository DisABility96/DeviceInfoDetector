<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ========== 基础信息区域 ========== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_basic_info"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tvBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_brand"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvDeviceModelFull"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_device_model_full"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvManufacturer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_manufacturer"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvAndroidVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_android_version"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvSdkVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_sdk_version"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>
        <TextView
            android:id="@+id/tvBluetoothVer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_bluetooth_ver"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <!-- ========== 硬件信息区域 ========== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_hardware_info"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/tvCpuCore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_cpu_core"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvCpuModel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_cpu_model"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvTotalMemory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_total_memory"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvAvailableRam"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_available_ram"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvScreenResolution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_screen_resolution"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvRefreshRate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_refresh_rate"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <!-- ========== 网络信息区域 ========== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_network_info"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/tvNetworkType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_network_type"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvIpv4Address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_ipv4_address"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvConnectionSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_connection_speed"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvSignalStrength"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_signal_strength"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvWifiStandard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_wifi_standard"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvDomainName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_domain_name"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvNetworkOperator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_network_operator"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvOperatorCountry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_operator_country"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvSupport5g4g"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_support_5g_4g"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>


        <!-- ========== 应用信息区域 ========== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_app_info"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/tvSystemAppCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_system_app_count"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvUserAppCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_user_app_count"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvAppTotalSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_app_total_size"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <!-- ========== 相机信息区域 ========== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_camera_info"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/tvCameraSensorSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_camera_sensor_size"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvCameraEffectivePixels"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_camera_effective_pixels"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvCameraResolution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_camera_resolution"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvCameraEquivalentFocal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_camera_equivalent_focal"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvCameraShutterSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_camera_shutter_speed"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvCameraOis"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_camera_ois"
            android:textSize="16sp"/>

    </LinearLayout>
</ScrollView>